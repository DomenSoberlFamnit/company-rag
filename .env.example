# Copy to .env and adjust:  cp .env.example .env

# --- Required -----------------------------------------------------------------
# Generate with:  openssl rand -hex 32
WEBUI_SECRET_KEY=change-me

# --- Image versions (pin these for production) --------------------------------
OLLAMA_VERSION=latest
OPEN_WEBUI_VERSION=main

# --- Models -------------------------------------------------------------------
# Rough VRAM guide for Qwen3 (Q4): 4b ~3 GB, 8b ~6 GB, 14b ~10 GB,
# 30b-a3b (MoE) ~19 GB, 32b ~20 GB. BGE-M3 adds ~1.2 GB.
CHAT_MODEL=qwen3:8b
EMBEDDING_MODEL=bge-m3

# --- Ollama -------------------------------------------------------------------
# Context window in tokens. RAG puts retrieved chunks in the prompt, so keep
# this well above the default. Larger values use more VRAM.
OLLAMA_CONTEXT_LENGTH=16384
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_KEEP_ALIVE=24h

# --- Web UI -------------------------------------------------------------------
WEBUI_NAME=Company Assistant
# Public URL users open (used for links and OAuth callbacks)
WEBUI_URL=http://localhost:3000
# 127.0.0.1 = reachable only through a reverse proxy on this host (recommended).
# 0.0.0.0   = reachable directly from the network on WEBUI_PORT.
WEBUI_BIND_ADDRESS=127.0.0.1
WEBUI_PORT=3000
ENABLE_SIGNUP=true
# pending = new sign-ups need admin approval; user = active immediately
DEFAULT_USER_ROLE=pending
USER_KNOWLEDGE_ACCESS=true

# --- RAG ----------------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RAG_TOP_K=6
ENABLE_RAG_HYBRID_SEARCH=true
RAG_RERANKING_MODEL=BAAI/bge-reranker-v2-m3
RAG_TOP_K_RERANKER=4
RAG_RELEVANCE_THRESHOLD=0.0
RAG_EMBEDDING_BATCH_SIZE=16
RAG_FILE_MAX_SIZE=100
RAG_FILE_MAX_COUNT=20
# Empty = built-in extractors. Set to "tika" or "docling" if you add one of
# those services for better PDF/OCR handling.
CONTENT_EXTRACTION_ENGINE=
PDF_EXTRACT_IMAGES=false
